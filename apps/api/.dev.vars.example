# Engine — local/dev environment variables (example)
#
# Copy to `.dev.vars` (gitignored) for `wrangler dev`, or set each as a
# Worker secret in production via `wrangler secret put <NAME>`.
# Generated from @engine/config INTEGRATIONS — edit the registry, not this file.

# ── Postgres (Neon) (data) ──
# Primary operational store — accounts, projects, entities, findings, actions, onboarding, subscriptions.
# Account: Neon (managed Postgres, AWS ap-southeast-1 / Singapore). Identity via Neon Auth.
# Neon Postgres connection string (pooled). Bound as a Worker secret. [secret, required]
DATABASE_URL=postgres://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/engine?sslmode=require

# ── Neon Auth (Better Auth) (identity) ──
# User identity + the API auth gate: the dashboard signs in here, and apps/api verifies the resulting JWT against the published JWKS.
# Account: Neon Auth (managed Better Auth) — already enabled on the Neon project; Google sign-in configured there.
# Neon Auth's public JWKS endpoint. Public, not a secret — it publishes verification keys, not signing keys. [config, required]
AUTH_JWKS_URL=https://<project>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Expected `iss` claim. Optional: leave unset to accept any issuer the JWKS key signs for. [config, optional]
AUTH_ISSUER=https://<project>.neonauth.<region>.aws.neon.tech/neondb/auth
# Expected `aud` claim. Optional — set once Neon Auth is configured to mint audience-scoped tokens. [config, optional]
AUTH_AUDIENCE=engine-api
# Shared service token for machine callers with no user session (the edge worker's C1.7 auto-rollback). Bind the same value on apps/api and apps/workers. [secret, optional]
INTERNAL_API_TOKEN=a-long-random-string
# Set to 'disabled' to run the API unauthenticated. Honoured only for requests to a loopback host, so setting it on a deployed Worker refuses requests rather than opening them. [config, optional]
AUTH_MODE=disabled
# Comma-separated invite list. Unset means any Google account that clears the consent screen may sign in and create its own account — set this to enforce the "invite-only, pre-alpha" the sign-in screen claims. [config, optional]
ALLOWED_EMAILS=first@example.com,second@example.com

# ── Credential sign-in (fixed pre-alpha roster) (identity) ──
# Signs the three pre-alpha users in with an email and password, minting a session token the API verifies itself. Exists because Neon Auth cannot complete a Google sign-in from the deployed dashboard origin.
# Account: None — no third party. Both values are chosen by whoever operates the deployment.
# (optional for pre-alpha)
# The roster: `email:password[:Display Name]`, comma-separated. A password cannot contain a comma or a colon. This is a secret — it holds live passwords. [secret, required]
LOCAL_AUTH_USERS=first@example.com:a-long-password:First Person,second@example.com:another-password
# HMAC key for the session tokens `POST /auth/login` mints. Rotating it signs everyone out. Use a different value from OAUTH_STATE_SECRET. [secret, required]
LOCAL_AUTH_SECRET=a-long-random-string

# ── Resend (transactional email) (identity) ──
# Delivers the sign-in codes, invitations and password-reset mail the accounts-and-access work sends. One HTTPS call per message from the Worker; no binding.
# Account: A Resend account with the sending domain verified (SPF and DKIM records on the zone). The free plan is 3,000 emails a month, 100 a day. Chosen over Cloudflare Email Service because that needs Workers Paid and this deployment stays on Free.
# Resend API key (re_...). Bound as a Worker secret. [secret, required]
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The From header on every message, `Name <address>`. The address must be on a domain verified in Resend, or every send is refused. [config, required]
EMAIL_FROM=Engine <login@example.com>

# ── Google integrations (Search Console, GA4, Business Profile) (identity) ──
# Customers connect their own Google accounts in the product: GSC search performance, GA4 traffic, and GBP location reads plus C5 write-back.
# Account: One Google Cloud project with an OAuth 2.0 Web client. Enable: Search Console API; Analytics Data API AND Analytics Admin API; My Business Account Management, Business Information and Google My Business (v4) APIs.
# OAuth 2.0 client ID. One client serves all three providers — they differ only by scope. [config, required]
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# OAuth 2.0 client secret. Bound as a Worker secret. [secret, required]
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# The registered redirect URI. Google matches it byte-for-byte, so it must equal the deployed origin plus `/oauth/google/callback` exactly. [config, required]
GOOGLE_REDIRECT_URI=https://engine-api.workers.dev/oauth/google/callback
# base64 of 32 random bytes (`openssl rand -base64 32`). Seals customer refresh tokens at rest (AES-256-GCM). Rotating it invalidates every stored connection — every customer must reconnect. [secret, required]
ENCRYPTION_KEY=ZmFrZS1rZXktZm9yLXRoZS1leGFtcGxlLW9ubHktMzJiIQ==
# Signs the OAuth `state` parameter. An override only: since #82 the secret is generated and stored sealed in `platform_credentials` on first use (`ensureStateSecret`), so a deployment that never sets this still signs state. Set it to pin the value explicitly, and it wins. [secret, optional]
OAUTH_STATE_SECRET=a-long-random-string
# Dashboard origin, for the post-consent return link. Optional — the callback page still renders without it. [config, optional]
DASHBOARD_URL=https://engine-7vv.pages.dev/app

# ── Stripe (billing) (billing) ──
# G3 billing: subscription lifecycle synced from Stripe webhooks into our read-model; plan/usage/over-limit enforcement.
# Account: Stripe account (test mode is enough for pre-alpha) with products/prices for the plan tiers and a webhook endpoint.
# Signing secret for the `/billing/webhook` endpoint (whsec_...). Bound as a Worker secret. [secret, required]
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# JSON map of Stripe price id → our PlanTier, e.g. {"price_starter":"starter","price_growth":"growth"}. [config, required]
STRIPE_PRICE_TO_TIER={"price_starter_monthly":"starter","price_growth_monthly":"growth"}
# Stripe secret API key. Required for `POST /accounts/:id/billing/checkout` (M1.7); webhook verification does not use it. [secret, optional]
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Serper.dev (SERP data) (serp) ──
# A1 rank tracking: Google SERP positions + features (AI Overview presence, local pack, PAA) per tracked keyword/geo/device.
# Account: Serper.dev account (2,500 free credits on signup; prepaid credits after — cannot bill-shock).
# Which SERP adapter to use. 'serper' today; the interface also supports 'dataforseo'/'serpapi' for a later switch. [config, optional]
SERP_PROVIDER=serper
# Serper.dev API key (X-API-KEY header). Bound as a Worker secret. Since 2026-09-09 Serper is also connectable per client, and a client's own key wins over this one; this is the fallback for clients that have connected none. [secret, required]
SERPER_API_KEY=serper_xxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (LLM engine) (llm) ──
# A2 AI visibility: poll OpenAI for answers to tracked prompts, extract citations/sources (n-sampling → confidence band).
# Account: OpenAI API account with a funded key.
# (optional for pre-alpha)
# OpenAI API key. Bound as a Worker secret. [secret, required]
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Model id to poll (defaults to a current small model if unset). [config, optional]
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (LLM engine) (llm) ──
# A2 AI visibility: second LLM engine — Gemini readiness alongside OpenAI, with grounding-source citation extraction.
# Account: Google AI Studio / Gemini API key (generous free tier).
# (optional for pre-alpha)
# Google Gemini API key (AI Studio). Bound as a Worker secret. [secret, required]
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
# Gemini model id to poll (defaults to a current flash model if unset). [config, optional]
GEMINI_MODEL=gemini-2.0-flash

# ── Sarvam (LLM engine) (llm) ──
# A2 AI visibility: poll Sarvam for answers to tracked prompts and extract citations. The engine this deployment runs on.
# Account: Sarvam AI account with API credits.
# Sarvam API subscription key (api-subscription-key header). Bound as a Worker secret. [secret, required]
SARVAM_API_KEY=sk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
# Sarvam model id to poll. Defaults to 'sarvam-105b'. The key's own model list is the authority on what is accepted. [config, optional]
SARVAM_MODEL=sarvam-105b

# ── GitHub (PR export) (deploy) ──
# C4.5 GitHub PR export: for headless sites with no edge worker or CMS plugin, deploy a fix as a reviewable PR against the customer's repo (@engine/deploy's 'github-pr' DeployTarget).
# Account: A GitHub App or fine-grained PAT with contents:write + pull-requests:write on the customer repo(s).
# (optional for pre-alpha)
# Token used to call GitHub's REST API on the customer's behalf. Bound as a Worker secret. Per-account tokens are a later scope; this is a single shared token for pre-alpha. [secret, required]
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
