{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Turbo 2 runs tasks in strict env mode: a variable not named here is
      // stripped from the task's environment. ENGINE_API_BASE is read by
      // apps/dashboard/scripts/assembleSite.mjs to bake the API origin into
      // the deployed page, so without this line `turbo run build` silently
      // produced a site with no API origin — the script warned, but the
      // warning is indistinguishable from a genuine local build.
      // Declaring it here also makes it part of the cache key, so changing
      // the value re-runs the build instead of restoring a stale site.
      "env": ["ENGINE_API_BASE"],
      // site/** is a build output too (assembleSite writes it). Left out, a
      // cache hit restores dist/ but not the assembled site, and the deploy
      // step publishes whatever happened to be on disk.
      "outputs": ["dist/**", "site/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Strict env mode strips anything not named here, so the *.db.test.ts
      // suites saw no `TEST_DATABASE_URL` under `turbo run test` and skipped
      // themselves — reported as "skipped", which reads the same whether the
      // operator has a database or not. Named as passThroughEnv rather than
      // env because it must not become part of the cache key: two developers
      // with different scratch connection strings should share a cache hit.
      "passThroughEnv": ["TEST_DATABASE_URL"]
    }
  }
}
