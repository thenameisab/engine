# Installed skill copies (reproducible from skills-lock.json)
.agents/
.claude/skills/

# Local, machine-specific settings
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Deps / build
node_modules/
dist/
apps/dashboard/site/
apps/web/site/
.turbo/
*.tsbuildinfo
.env
.env.*

# Wrangler local secrets — the real values live here (gitignored); the
# committed `.dev.vars.example` documents the shape.
.dev.vars
!.dev.vars.example

# Wrangler's local state/cache, created by `wrangler dev`. Build output, and it
# holds a local copy of the dev bindings — never commit it.
.wrangler/
